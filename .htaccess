Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^public(?:/|$) - [F,L]
    RewriteRule ^(assets|css|js|build)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
